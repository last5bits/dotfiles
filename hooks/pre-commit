#!/usr/bin/env bash
# Pre-commit hook: run checks on staged files

set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FAILED=0

# --- stylua (Lua formatting) ---
NVIM_LUA_FILES=$(echo "$STAGED_FILES" | grep "^home/.config/nvim/.*\.lua$" || true)
if [ -n "$NVIM_LUA_FILES" ]; then
  if command -v stylua &>/dev/null; then
    echo "Running stylua on staged Lua files..."
    stylua $NVIM_LUA_FILES
    echo "$NVIM_LUA_FILES" | xargs git add 2>/dev/null
  else
    echo "stylua not found, skipping Lua formatting"
  fi
fi

# --- luacheck (Lua linting) ---
if [ -n "$NVIM_LUA_FILES" ]; then
  if command -v luacheck &>/dev/null; then
    echo "Running luacheck on staged Lua files..."
    if ! luacheck $NVIM_LUA_FILES; then
      FAILED=1
    fi
  else
    echo "luacheck not found, skipping Lua linting"
  fi
fi

# --- trailing whitespace ---
TRAILING_FILES=$(echo "$STAGED_FILES" | grep -v '\.snippets$' || true)
if [ -n "$TRAILING_FILES" ]; then
  echo "Checking for trailing whitespace..."
  for file in $TRAILING_FILES; do
    if git diff --cached --check -- "$file" 2>/dev/null | grep -q "trailing whitespace"; then
      echo "  trailing whitespace in $file"
      FAILED=1
    fi
  done
fi

# --- end-of-file newline ---
echo "Checking for missing end-of-file newlines..."
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    if [ -s "$file" ] && [ "$(tail -c 1 "$file" | wc -l)" -eq 0 ]; then
      echo "  missing newline at EOF: $file"
      echo "" >> "$file"
      git add "$file"
    fi
  fi
done

if [ "$FAILED" -ne 0 ]; then
  echo "Pre-commit checks failed. Fix the issues above and try again."
  exit 1
fi

exit 0
